 "affixes": [
  {
   "key": "inversebone",
   "name": "逆骨",
   "benefit": "适用物理技能的物攻项改读物防，首轮换算1:1。",
   "cost": "这些公式项不再读取物攻；物防不再用于抵御物理伤害。"
  },
  {
   "key": "blessing",
   "name": "祸祝",
   "benefit": "可转换的友方数值增益技能改为敌方对应诅咒。",
   "cost": "这些技能整场失去友方增益用途；原伤害、治疗和被动保留。"
  },
  {
   "key": "mimic",
   "name": "百相",
   "benefit": "记录敌人展示的最多3项合法攻击，在一个仿形槽使用其中1项。",
   "cost": "替换一个已学会的主动技能；开场仿形槽为空，切换消耗原有行动。"
  },
  {
   "key": "prayer",
   "name": "逆祷",
   "benefit": "可转换的攻击改为对应目标结构的治疗，按标准治疗总预算结算。",
   "cost": "自身全部对敌伤害失效；原治疗、辅助和被动保留。"
  },
  {
   "key": "pest",
   "name": "疫囊",
   "benefit": "每个自然回合结束向全体敌人传播可传播数值减益和持续伤害。",
   "cost": "自己必须承受这些异常，不能免疫、净化或主动缩短；自然到期保留。"
  },
  {
   "key": "faceless",
   "name": "无面",
   "benefit": "从已拥有角色借入最多两个合法主动技能，使用自己的属性和培养。",
   "cost": "一一替换自己的已学会主动技能，不继承来源被动、资源或额外行动。"
  },
  {
   "key": "hollow",
   "name": "空壳",
   "benefit": "生命上限变为1，原生命容量成为护盾容量；MP恢复按原生命/MP比例转为护盾。",
   "cost": "初始护盾仅按原剩余生命换算；治疗与吸血失效，护盾沿原生规则衰减。"
  },
  {
   "key": "lifelink",
   "name": "连命",
   "benefit": "与一名队友共享合并生命池，各自护盾、防御与抵抗独立结算。",
   "cost": "全体攻击命中两人扣两次；生命池归零两人倒下，治疗只增加一次。"
  },
  {
   "key": "swallow",
   "name": "吞器",
   "benefit": "保留本武器并借用背包一件武器的登记效果。",
   "cost": "不继承供体属性、成长或异化；整场关闭衣服栏属性与效果，供体被占用。"
  },
  {
   "key": "possession",
   "name": "夺舍",
   "benefit": "取得绑定队友的登记主动技能与普通被动特性，使用自身属性与费用。",
   "cost": "队友整场退出战斗，不提供装备、资源与行动；自己倒下时两人退场。"
  },
  {
   "key": "insulation",
   "name": "绝缘",
   "benefit": "免疫外来的登记数值减益、控制和驱散。",
   "cost": "拒绝外来治疗、护盾、数值增益、回蓝、赠行、觉醒与复活；自给保留。"
  },
  {
   "key": "sacrifice",
   "name": "舍身",
   "benefit": "自身获得的治疗、护盾和登记数值增益转给绑定队友。",
   "cost": "自己不获得这些收益；目标倒下则作废，不转移身份、资源或额外行动。"
  },
  {
   "key": "scapegoat",
   "name": "嫁祸",
   "benefit": "敌方伤害行动先交由绑定保护者，以保护者防御、抵抗与护盾承受。",
   "cost": "自己没有独立生命与护盾池，治疗失效；持续伤害、反噬和生命费用由保护者支付。"
  },
  {
   "key": "silence",
   "name": "缄默",
   "benefit": "一个登记攻击技能用生命上限锁定支付MP费用，并绕过魔法沉默。",
   "cost": "费用按未减耗面板MP/开场MP计算：每100%锁定20%生命上限；每次施放累积，战后解除。"
  },
  {
   "key": "wish",
   "name": "恶愿",
   "benefit": "登记的单体数值增益改为其他全体队友获得。",
   "cost": "自己先承受对应逆向减益，不能抵抗或净化；代价和收益同窗到期，群体增益不额外扩大。"
  },
  {
   "key": "offer",
   "name": "献器",
   "benefit": "把自身装备的登记效果交给绑定队友，不继承基础属性和成长。",
   "cost": "自己整场失去所有装备属性、效果与套装；目标倒下也不返还，不转移异化或身份效果。"
  },
  {
   "key": "jail",
   "name": "囚厄",
   "benefit": "接收其他队友实际成功获得的登记减益和控制，不复制。",
   "cost": "接收后不能免疫、抵抗或净化，硬控制仍会封锁行动；不接收伤害、资源扣除或身份。"
  },
  {
   "key": "glutton",
   "name": "饕餮",
   "benefit": "吞掉自身登记数值增益取得饥饿储备；吞噬技能耗10TP和一次行动吞敌方增益。",
   "cost": "实际MP上限为0，回蓝失效、增益不留在自己身上；MP费用改从有限饥饿储备扣除，开场为0。"
  },
  {
   "key": "erosion",
   "name": "蚀术",
   "benefit": "选定攻击保留护盾伤害，命中后封印目标上次使用的合法技能。",
   "cost": "该攻击生命伤害及随同行动伤害归零；封印成功也封印自身攻击，至一次原有合法行动窗口结束。"
  },
  {
   "key": "void",
   "name": "归墟",
   "benefit": "自身攻击以无元素结算，绕过特定元素抵抗、吸收与免疫。",
   "cost": "失去元素增伤、攻击附加状态、持续伤害附着与元素派生；物理/魔法类别、防御与通用减伤保留。"
  }
 ],
