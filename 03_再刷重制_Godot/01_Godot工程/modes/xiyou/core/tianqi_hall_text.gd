static func on(s) -> bool:
	return ENABLED and s != null and XTianqi.active(s)


static func corruption_after(s, event_id: int) -> Array:
	if not on(s) or not CORRUPTION_AFTER_LINES.has(event_id):
		return []
	return CORRUPTION_AFTER_LINES[event_id]


static func rewrite_message(s, map_id: int, event_id: int, msg: Dictionary) -> Dictionary:
	if map_id != MAP or not on(s):
		return msg
	var lines: Array = msg.get("lines", []).duplicate()
	var joined := "\n".join(lines)
	var changed := false
	if MERGED_SPEAKERS.has(event_id):
		var sp: Array = MERGED_SPEAKERS[event_id]
		msg["face"] = str(sp[0])
		msg["index"] = int(sp[1])
		changed = true
	if MSG_RULES.has(event_id):
		for rule in MSG_RULES[event_id]:
			if joined.contains(str(rule[0])):
				msg["lines"] = (rule[1] as Array).duplicate()
				if rule.size() >= 4:
					msg["face"] = str(rule[2])
					msg["index"] = int(rule[3])
				changed = true
				break
	if not changed:
		return msg
	return msg


static func rewrite_choices(s, map_id: int, event_id: int, msg: Dictionary) -> Dictionary:
	if map_id != MAP or not on(s) or not CHOICE_RULES.has(event_id):
		return msg
	var raw: Array = msg.get("choices", [])
	if raw.is_empty():
		return msg
	var joined := "|".join(raw.map(func(x): return str(x)))
	for rule in CHOICE_RULES[event_id]:
		var needles: Array = rule[0]
		var rep: Array = rule[1]
		if rep.size() == raw.size() and needles.all(func(n): return joined.contains(str(n))):
			if event_id == 1:
				var out := raw.duplicate()
				var idx := out.find("关于捕诱器")
				if idx >= 0:
					out[idx] = "关于抓宠"
					msg["choices"] = out
				return msg
			msg["choices"] = rep.duplicate()
			return msg
	return msg
