## 位置名（四队共用一套模板，敌人显示成「网吧队·上单」）
const ROLES := ["上单", "打野", "中单", "下路", "辅助"]
## 敌人显示名：队名·位置
static func enemy_name(team_index: int, role_index: int) -> String:
	return "%s·%s" % [TEAMS[team_index].name, ROLES[role_index]]

