  "script|// 定义一个数组，存储半人马角色的id\nvar invalidActorIds = [41, 42, 43, 44];\n\n// 获取当前队伍中上阵的四个角色\nvar actors = $gameParty.battleMembers();\n\n// 循环遍历每个角色\nactors.forEach(function(actor) {\n  // 判断角色 ID 是否在数组中\n  if (invalidActorIds.includes(actor.actorId())) {\n    // 增加半人马数量的值\n    var j = $gameVariables.value(885);\n    $gameVariables.setValue(885, j+1);\n  }\n});\n\n// 减去自身\nvar j = $gameVariables.value(885);\n$gameVariables.setValue(885, j-1);": "F",
  "script|// 获取上阵的四个角色对象\nvar actor1 = $gameParty.battleMembers()[0];\nvar actor2 = $gameParty.battleMembers()[1];\nvar actor3 = $gameParty.battleMembers()[2];\nvar actor4 = $gameParty.battleMembers()[3];\n\n// 确保角色对象存在且不是 null，并为每个角色添加状态\nif (actor1 && $gameVariables.value(893)<=5) {\n    actor1.addState(1113); // 将状态ID替换为你要添加的状态的实际ID\n}\nif (actor2 && $gameVariables.value(894)<=5) {\n    actor2.addState(1113);\n}\nif (actor3 && $gameVariables.value(895)<=5) {\n    actor3.addState(1113);\n}\nif (actor4 && $gameVariables.value(896)<=5) {\n    actor4.addState(1113);\n}": "E",
