; 再刷重制：双入口（西游改版、新版）；开发编号见 config/version。
config_version=5

[application]
config/name="再刷重制"
config/description="西游改版优先重制，新版保留入口。"
config/version="dev.151"
run/main_scene="res://scenes/entry_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="KYO/再刷重制_开发"

[autoload]
GameApp="*res://core/game_app.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[audio]
driver/enable_input=false

[internationalization]
locale/include_text_server_data=true
